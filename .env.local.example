# Backend API base URL
NEXT_PUBLIC_API_URL=https://dev-assesment-backend.onrender.com/api/v1

# Frontend URL (used by Stripe redirect and Google OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe test publishable key (client-side, safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Google OAuth client id (client-side, for the Google sign-in button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# Price per credit (USD) — kept in sync with the backend ($0.50/credit)
NEXT_PUBLIC_CREDIT_PRICE_USD=0.5
